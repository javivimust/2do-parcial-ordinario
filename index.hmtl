<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="contenedor">

    <nav class="menu">
        <a href="#">Inicio</a>
        <a href="#">Somos</a>
        <a href="#">Agregar</a>
        <a href="#" class="activo">Alta</a>
        <a href="#">Visítanos</a>
    </nav>

    <div class="titulo">
        Regístrate en este sitio
    </div>

    <div class="formulario">
        <form>
            <label>Nombre de usuario</label>
            <input type="text">

            <label>Correo electrónico</label>
            <input type="email">

            <p>Se te enviará una confirmación del registro por correo electrónico.</p>

            <button type="submit">Registrarse</button>
        </form>
    </div>

</div>

</body>
</html>